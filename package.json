{
  "name": "story-review",
  "displayName": "Story Review",
  "description": "Read a story review page inside VS Code, with hover, go to definition and references on its diff lines.",
  "publisher": "local",
  "version": "0.4.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "storyReview.open",
        "title": "Open Review",
        "category": "Story Review",
        "icon": "$(book)"
      },
      {
        "command": "storyReview.toggleSplit",
        "title": "Split or Unified Diff",
        "category": "Story Review",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "storyReview.keys",
        "title": "Keyboard Shortcuts",
        "category": "Story Review",
        "icon": "$(keyboard)"
      },
      {
        "command": "storyReview.goto",
        "title": "Go To",
        "category": "Story Review"
      }
    ],
    "configuration": {
      "title": "Story Review",
      "properties": {
        "storyReview.reviewsRoot": {
          "type": "string",
          "default": "~/.claude/story-reviews",
          "description": "Folder holding the review folders (<owner>-<repo>/pr-<n>/page.html and meta.json)."
        },
        "storyReview.colorTheme": {
          "type": "string",
          "default": "",
          "markdownDescription": "Theme for code colours on the review page. Leave empty to follow VS Code. Accepts a VS Code built-in theme (`Dark 2026`, `Dark Modern`, `Light+`), a bundled theme (`One Dark Pro`, `GitHub Dark Default`, `Catppuccin Mocha`, ...), or the path to a theme's `.json` file on the machine where your code lives."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "storyReview",
          "title": "Story Review",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "storyReviewNotes",
          "title": "Review Notes",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "storyReview": [
        {
          "id": "storyReview.chapters",
          "name": "Chapters"
        },
        {
          "id": "storyReview.findings",
          "name": "Findings"
        },
        {
          "id": "storyReview.files",
          "name": "Files"
        }
      ],
      "storyReviewNotes": [
        {
          "id": "storyReview.notes",
          "name": "Notes",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "storyReview.chapters",
        "contents": "No review is open.\n[Open Review](command:storyReview.open)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "storyReview.open",
          "when": "view == storyReview.chapters",
          "group": "navigation@1"
        },
        {
          "command": "storyReview.toggleSplit",
          "when": "view == storyReview.chapters",
          "group": "navigation@2"
        },
        {
          "command": "storyReview.keys",
          "when": "view == storyReview.chapters",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "storyReview.goto",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --loader:.jsonc=text --outfile=out/extension.js --log-level=warning",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --loader:.jsonc=text --outfile=out/extension.js --watch",
    "package": "npm run build && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package -o dist/",
    "install-vsix": "node scripts/install.mjs",
    "release": "npm run package && npm run install-vsix",
    "test": "node test/tokens-test.mjs && node test/bridge-test.mjs",
    "fixture": "node test/fixture/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholasm185/vscode-story-review.git"
  },
  "dependencies": {
    "shiki": "^3.23.0"
  }
}
